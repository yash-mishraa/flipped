# Flipped Environment Configuration
# Copy this file to .env.local for local development.

# Database configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flipped_db?schema=public"

# Security & Session Secret (used for signing guest sessions)
GUEST_SESSION_SECRET="change-this-to-a-secure-random-secret-in-production-min-32-chars"

# Game Scheduling Timezone (Default: Asia/Kolkata)
APP_TIMEZONE="Asia/Kolkata"
